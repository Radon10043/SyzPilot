    "version": "0.2.0",
    "configurations": [
        {
            "name": "go: launch generator",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/generator",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/linux.db",
                "-outdir=${workspaceFolder}/workdir/out",
                "-kernel=/vol/linux/v6.12",
                "-model=gemini-2.5-flash",
            ]
        },
        {
            "name": "go: launch generator (2 jobs)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/generator",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/linux.db",
                "-outdir=${workspaceFolder}/workdir/out",
                "-kernel=/vol/linux/v6.12",
                "-model=gemini-2.5-flash",
                "-jobs=2"
            ]
        }
    ]
}