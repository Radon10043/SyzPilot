{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "go: launch src/rmunused",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/rmunused",
            "cwd": "${workspaceFolder}",
            "args": [
                "-indir=${workspaceFolder}/syzkaller/sys/linux"
            ],
        },
        {
            "name": "go: launch experiment/cloud-trimtool",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/experiment/cloud-trimtool",
            "cwd": "${workspaceFolder}",
            "args": [
                "-db=${workspaceFolder}/data/database/linux.db",
                "-kernel=${workspaceFolder}/../../kernel/linux/v6.18/build",
                "-os=linux",
                "-model=gemini-3-flash-preview",
                "-outdir=${workspaceFolder}/.workdir/ablation/trimtool",
                "-ref=${workspaceFolder}/data/refs/linux/sg.txt",
                "-sysdir=${workspaceFolder}/data/trimsys",
                "-disable=get_func_code_by_name",
                "-jobs=1"
            ],
        },
        {
            "name": "go: launch experiment/cloud-noiter",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/experiment/cloud-noiter",
            "cwd": "${workspaceFolder}",
            "args": [
                "-db=${workspaceFolder}/data/database/linux.db",
                "-model=gemini-3-flash-preview",
                "-outdir=${workspaceFolder}/.workdir/ablation/noiter",
                "-ref=${workspaceFolder}/data/refs/linux/sg.txt",
                "-jobs=1"
            ],
        },
        {
            "name": "go: launch experiment/cloud-nodb",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/experiment/cloud-nodb",
            "cwd": "${workspaceFolder}",
            "args": [
                "-db=${workspaceFolder}/data/database/linux.db",
                "-kernel=${workspaceFolder}/../../kernel/linux/v6.18/build",
                "-model=gemini-3-flash-preview",
                "-outdir=${workspaceFolder}/.workdir/ablation/nodb",
                "-ref=${workspaceFolder}/data/refs/linux/sg.txt",
                "-sysdir=${workspaceFolder}/data/trimsys",
                "-jobs=1"
            ],
        },
        {
            "name": "go: launch experiment/viz/align",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/experiment/viz/align",
            "args": [
                "-input=${workspaceFolder}/.workdir/acc/align.csv",
            ],
        },
        {
            "name": "go: launch experiment/viz/fuzz",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/experiment/viz/fuzz",
            "args": [
                "-expdir=${workspaceFolder}/.workdir/experiment",
                "-master=cloud",
            ],
        },
        {
            "name": "go: launch refactor",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/refactor",
            "args": [
                "-indir=${workspaceFolder}/.workdir/specs/linux-v6.18-kernel-gemini-3-flash-preview/specs",
                "-outdir=${workspaceFolder}/.workdir/specs/linux-v6.18-kernel-gemini-3-flash-preview/refactor",
            ]
        },
        {
            "name": "go: launch generator (fuchsia)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/generator-fuchsia",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-model=gemini-3-flash-preview",
                "-kernel=${workspaceFolder}/../../kernel/fuchsia/releases.f31/mini-fuchsia",
                "-outdir=${workspaceFolder}/.workdir/debug/generator-fuchsia",
                "-fidlsyz-dir=${workspaceFolder}/.workdir/debug/fidlsyz",
                "-jobs=1"
            ],
            "preLaunchTask": "make syz-utils"
        },
        {
            "name": "go: launch generator (android)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/generator",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/android.db",
                "-os=android",
                "-model=gemini-3-flash-preview",
                "-kernel=${workspaceFolder}/../../kernel/android/common-android17-6.18",
                "-outdir=${workspaceFolder}/.workdir/debug/generator-android",
                "-ref=${workspaceFolder}/data/refs/android/dm.txt",
            ],
            "preLaunchTask": "make syz-utils"
        },
        {
            "name": "go: launch generator (netbsd)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/generator",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/netbsd.db",
                "-os=netbsd",
                "-model=gemini-3-flash-preview",
                "-kernel=/vol/netbsd/15e7fbc5",
                "-outdir=${workspaceFolder}/.workdir/debug/generator-netbsd",
                "-ref=${workspaceFolder}/data/refs/netbsd/hdaudio.txt",
            ],
            "preLaunchTask": "make syz-utils"
        },
        {
            "name": "go: launch minitask (netbsd)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/minitask",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/netbsd.db",
                "-os=netbsd",
                "-outdir=${workspaceFolder}/.workdir/debug/minitask-netbsd",
                "-model=gemini-3-flash-preview",
            ]
        },
        {
            "name": "go: launch minitask (openbsd)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/minitask",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/openbsd.db",
                "-os=openbsd",
                "-outdir=${workspaceFolder}/.workdir/debug/minitask-openbsd",
                "-model=gemini-3-flash-preview",
            ]
        },
        {
            "name": "go: launch minitask (freebsd)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/minitask",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/freebsd.db",
                "-os=freebsd",
                "-outdir=${workspaceFolder}/.workdir/debug/minitask-freebsd",
                "-model=gemini-3-flash-preview",
            ]
        },
        {
            "name": "go: launch minitask (linux)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/minitask",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/linux.db",
                "-os=linux",
                "-outdir=${workspaceFolder}/.workdir/debug/minitask-linux",
                "-model=gemini-3-flash-preview",
            ]
        },
        {
            "name": "go: launch syz-manager",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/syzkaller/bin/syz-manager",
            "args": [
                "-config=${workspaceFolder}/.workdir/fuzz/test.cfg"
            ]
        }
    ]
}