{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "go: launch src/rmunused/main.go",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/rmunused/main.go",
            "cwd": "${workspaceFolder}",
            "args": [
                "-indir=${workspaceFolder}/syzkaller/sys/linux"
            ],
        },
        {
            "name": "go: launch experiment/ablation/trimtool/main.go",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/experiment/ablation/trimtool/main.go",
            "cwd": "${workspaceFolder}",
            "args": [
                "-db=${workspaceFolder}/data/database/linux.db",
                "-kernel=/vol/linux/v6.18/build",
                "-os=linux",
                "-model=gemini-3-flash-preview",
                "-outdir=${workspaceFolder}/workdir/ablation/trimtool",
                "-ref=${workspaceFolder}/data/refs/linux/sg.txt",
                "-sysdir=${workspaceFolder}/data/trimsys",
                "-disable=get_func_code_by_name",
                "-jobs=1"
            ],
        },
        {
            "name": "go: launch experiment/ablation/noiter/main.go",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/experiment/ablation/noiter/main.go",
            "cwd": "${workspaceFolder}",
            "args": [
                "-db=${workspaceFolder}/data/database/linux.db",
                "-model=gemini-3-flash-preview",
                "-outdir=${workspaceFolder}/workdir/ablation/noiter",
                "-ref=${workspaceFolder}/data/refs/linux/sg.txt",
                "-jobs=1"
            ],
        },
        {
            "name": "go: launch experiment/ablation/nodb/main.go",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/experiment/ablation/nodb/main.go",
            "cwd": "${workspaceFolder}",
            "args": [
                "-db=${workspaceFolder}/data/database/linux.db",
                "-kernel=/vol/linux/v6.18/build",
                "-model=gemini-3-flash-preview",
                "-outdir=${workspaceFolder}/workdir/ablation/nodb",
                "-ref=${workspaceFolder}/data/refs/linux/sg.txt",
                "-sysdir=${workspaceFolder}/data/trimsys",
                "-jobs=1"
            ],
        },
        {
            "name": "go: launch experiment/viz/align/main.go",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/experiment/viz/align/main.go",
            "args": [
                "-input=${workspaceFolder}/workdir/acc/align.csv",
            ],
        },
        {
            "name": "go: launch experiment/viz/fuzz/main.go",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/experiment/viz/fuzz/main.go",
            "args": [
                "-expdir=${workspaceFolder}/workdir/experiment",
                "-master=cloud",
            ],
        },
        {
            "name": "go: launch refactor",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/refactor",
            "args": [
                "-indir=${workspaceFolder}/workdir/specs/linux-v6.18-kernel-gemini-3-flash-preview/specs",
                "-outdir=${workspaceFolder}/workdir/specs/linux-v6.18-kernel-gemini-3-flash-preview/refactor",
            ]
        },
        {
            "name": "go: launch generator (netbsd)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/generator",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/netbsd.db",
                "-os=netbsd",
                "-model=gemini-3-flash-preview",
                "-kernel=/vol/netbsd/15e7fbc5",
                "-outdir=${workspaceFolder}/workdir/minitask",
                "-varlist=${workspaceFolder}/workdir/minitask/varlist.txt",
            ],
            "preLaunchTask": "make generator"
        },
        {
            "name": "go: launch minitask (netbsd)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/minitask",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/netbsd.db",
                "-os=netbsd",
                "-outdir=${workspaceFolder}/workdir/minitask",
                "-model=gemini-3-flash-preview",
            ],
            "preLaunchTask": "make minitask",
        },
        {
            "name": "go: launch minitask (openbsd)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/minitask",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/openbsd.db",
                "-os=openbsd",
                "-outdir=${workspaceFolder}/workdir/minitask",
                "-model=gemini-3-flash-preview",
            ],
            "preLaunchTask": "make minitask",
        },
        {
            "name": "go: launch minitask (freebsd)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/minitask",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/freebsd.db",
                "-os=freebsd",
                "-outdir=${workspaceFolder}/workdir/minitask",
                "-model=gemini-3-flash-preview",
            ],
            "preLaunchTask": "make minitask",
        },
        {
            "name": "go: launch minitask",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/minitask",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/linux.db",
                "-os=linux",
                "-outdir=${workspaceFolder}/workdir/minitask",
                "-model=gemini-3-flash-preview",
            ],
            "preLaunchTask": "make minitask"
        },
        {
            "name": "go: launch generator",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/generator",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/linux.db",
                "-os=linux",
                "-model=gemini-3-flash-preview",
                "-kernel=/vol/linux/v6.18/build",
                "-outdir=${workspaceFolder}/workdir/debug",
                "-ref=${workspaceFolder}/data/refs/linux/sg.txt",
                "-sysdir=${workspaceFolder}/data/trimsys",
            ],
            "preLaunchTask": "make generator"
        },
        {
            "name": "go: launch generator (2 jobs)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "github.com/Radon10043/cloud/src/generator",
            "args": [
                "-env=${workspaceFolder}/.env",
                "-db=${workspaceFolder}/data/database/linux.db",
                "-os=linux",
                "-model=gemini-3-flash-preview",
                "-kernel=/vol/linux/v6.18",
                "-outdir=${workspaceFolder}/workdir/debug",
                "-ref=${workspaceFolder}/data/refs/linux/sg.txt",
                "-model=gemini-3-flash-preview",
                "-jobs=2",
            ],
            "preLaunchTask": "make generator"
        },
        {
            "name": "go: launch syz-manager",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/syzkaller/bin/syz-manager",
            "args": [
                "-config=${workspaceFolder}/workdir/fuzz/test.cfg"
            ]
        }
    ]
}