+void Executor::computeOffsetsGEP(KGEPInstruction *kgepi,
+                                 const GetElementPtrInst *gepi) {
+  ref<ConstantExpr> constantOffset =
+      ConstantExpr::alloc(0, Context::get().getPointerWidth());
+  Type *currentType = gepi->getSourceElementType();
+  uint64_t index = 1;
+  bool firstIndex = true;
+
+  for (auto ii = gepi->idx_begin(), ie = gepi->idx_end(); ii != ie;
+       ++ii, ++index) {
+    const Value *operand = ii->get();
+
+    if (firstIndex) {
+      computeOffsetsSeqTy(kgepi, constantOffset, index, currentType, operand);
+      firstIndex = false;
+      continue;
+    }
+
+    if (StructType *st = dyn_cast<StructType>(currentType)) {
+      const StructLayout *sl = kmodule->targetData->getStructLayout(st);
+      const ConstantInt *ci = cast<ConstantInt>(operand);
+      uint64_t fieldIndex = ci->getZExtValue();
+      uint64_t addend = sl->getElementOffset((unsigned)fieldIndex);
+      constantOffset = constantOffset->Add(
+          ConstantExpr::alloc(addend, Context::get().getPointerWidth()));
+      currentType = st->getElementType(fieldIndex);
+    } else if (ArrayType *at = dyn_cast<ArrayType>(currentType)) {
+      Type *elementType = at->getElementType();
+      computeOffsetsSeqTy(kgepi, constantOffset, index, elementType, operand);
+      currentType = elementType;
+    } else if (VectorType *vt = dyn_cast<VectorType>(currentType)) {
+      Type *elementType = vt->getElementType();
+      computeOffsetsSeqTy(kgepi, constantOffset, index, elementType, operand);
+      currentType = elementType;
+    } else if (currentType->isPointerTy()) {
+      Type *elementType = get_non_opaque_pointer_element_type(currentType);
+      assert(elementType && "cannot compute GEP through opaque pointer type");
+      computeOffsetsSeqTy(kgepi, constantOffset, index, elementType, operand);
+      currentType = elementType;
+    } else {
+      assert("invalid type" && 0);
+    }
+  }
+
+  kgepi->offset = constantOffset->getZExtValue();
+}
