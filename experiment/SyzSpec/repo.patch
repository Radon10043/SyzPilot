+#!/bin/bash
+
+# this script generates syscall specifications for subsystems used in SyzSpec paper
+#
+# usage:
+#   SYZSPEC=$SYZSPEC KERNSRC=$KERNSRC OUTDIR=$OUTDIR $SYZSPEC/scripts/genspec.sh
+
+set -e
+
+if [ -z "$SYZSPEC" ] || [ -z "$KERNSRC" ] || [ -z "$OUTDIR" ]; then
+    echo "Usage: SYZSPEC=\$SYZSPEC KERNSRC=\$KERNSRC OUTDIR=\$OUTDIR $0"
+    exit 1
+fi
+
+mkdir -p $OUTDIR && cd $OUTDIR
+
+# ppp
+mkdir ppp && cd ppp
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=ppp_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_ppp" \
+    --spec-suffix="" \
+    --max-time=24h \
+    --spec-output="ppp" $KERNSRC/drivers/net/ppp/built-in.bc &
+cd ..
+
+# i2c
+mkdir i2c && cd i2c
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=i2cdev_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_i2c" \
+    --spec-suffix="" \
+    --max-time=24h \
+    --spec-output="i2c" $KERNSRC/drivers/i2c/built-in.bc &
+cd ..
+
+# infiniband
+mkdir infiniband && cd infiniband
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=ib_uverbs_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_infiniband" \
+    --spec-suffix="" \
+    --spec-output="infiniband" $KERNSRC/drivers/infiniband/core/built-in.bc &
+cd ..
+
+# input_event
+mkdir input_event && cd input_event
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=evdev_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_evdev" \
+    --spec-suffix="" \
+    --spec-output="input_event" \
+    --max-time=24h \
+    $KERNSRC/drivers/input/built-in.bc &
+cd ..
+
+# mapper
+mkdir mapper && cd mapper
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=dm_ctl_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_dm" \
+    --spec-suffix="" \
+    --spec-output="mapper" \
+    --max-time=24h \
+    $KERNSRC/drivers/md/built-in.bc &
+cd ..
+
+# ptmx
+mkdir ptmx && cd ptmx
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=tty_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_ptmx" \
+    --spec-suffix="" \
+    --spec-output="ptmx" \
+    --max-time=24h \
+    $KERNSRC/drivers/tty/built-in.bc &
+cd ..
+
+# sg
+mkdir sg && cd sg
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=sg_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_sg" \
+    --spec-suffix="" \
+    --spec-output="sg" \
+    --max-time=24h \
+    $KERNSRC/drivers/scsi/built-in.bc &
+cd ..
+
+# snd_seq
+mkdir snd_seq && cd snd_seq
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=snd_seq_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_snd_seq" \
+    --spec-suffix="" \
+    --spec-output="snd_seq" \
+    --max-time=24h \
+    $KERNSRC/sound/core/seq/built-in.bc &
+cd ..
+
+# uinput
+mkdir uinput && cd uinput
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=uinput_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_uinput" \
+    --spec-suffix="" \
+    --spec-output="uinput" \
+    --max-time=24h \
+    $KERNSRC/drivers/input/misc/built-in.bc &
+cd ..
+
+# io_uring_register (__do_sys_io_uring_register: fd, opcode, arg, nr_args)
+mkdir io_uring_register && cd io_uring_register
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=__do_sys_io_uring_register \
+    --spec-arguments-index=0 \
+    --spec-arguments-num=4 \
+    --spec-interface-name=io_uring_register \
+    --spec-prefix="" \
+    --spec-suffix="" \
+    --spec-output="iouring_register" \
+    --max-time=24h \
+    $KERNSRC/io_uring/built-in.bc &
+cd ..
+
+# io_uring_setup (__do_sys_io_uring_setup: entries, params)
+mkdir io_uring_setup && cd io_uring_setup
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=__do_sys_io_uring_setup \
+    --spec-arguments-index=0 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=io_uring_setup \
+    --spec-prefix="" \
+    --spec-suffix="" \
+    --spec-output="iouring_setup" \
+    --max-time=24h \
+    $KERNSRC/io_uring/built-in.bc &
+cd ..
+
+# io_uring_enter (__do_sys_io_uring_enter: fd, to_submit, min_complete, flags, argp, argsz)
+mkdir io_uring_enter && cd io_uring_enter
+nohup $SYZSPEC/build/bin/klee \
+    --entry-point=__do_sys_io_uring_enter \
+    --spec-arguments-index=0 \
+    --spec-arguments-num=6 \
+    --spec-interface-name=io_uring_enter \
+    --spec-prefix="" \
+    --spec-suffix="" \
+    --spec-output="iouring_enter" \
+    --max-time=24h \
+    $KERNSRC/io_uring/built-in.bc &
+cd ..
+
+echo "all tasks run in background, you can check the output in $OUTDIR"
\ No newline at end of file
diff --git a/scripts/genspec_subsystems.sh b/scripts/genspec_subsystems.sh
new file mode 100755
index 0000000..f84280b
--- /dev/null
+++ b/scripts/genspec_subsystems.sh
@@ -0,0 +1,677 @@
+#!/bin/bash
+
+# Generate syzlang specifications for 20 Linux kernel subsystems using SyzSpec.
+#
+# Usage:
+#   ./scripts/genspec_subsystems.sh -syzspec path -kernsrc path -outdir path -subsystem name[,name...]|all
+#
+# Options:
+#   -syzspec   Path to the SyzSpec root directory (contains build/bin/klee)
+#   -kernsrc   Path to the kernel source tree (compiled with LLVM bitcode)
+#   -outdir    Output directory for generated specifications
+#   -subsystem Required subsystem name, comma-separated list, or all
+#
+# Each selected subsystem runs sequentially with a 24-hour timeout.
+
+set -e
+
+SYZSPEC=""
+KERNSRC=""
+OUTDIR=""
+ALL_SUBSYSTEMS="autofs ax25 btrfs can comedi dri f2fs fuse i2c input kvm nilfs2 ocfs2 phonet ppp ptp rdma_cm sequencer sg x25"
+SELECTED_SUBSYSTEMS=""
+LAUNCHED_SUBSYSTEMS=""
+
+resolve_path() {
+    local path="$1"
+    local create_missing="$2"
+    local dir_path
+    local base_name
+
+    if [ -z "$path" ]; then
+        return 1
+    fi
+
+    if [ "$create_missing" = "create" ]; then
+        dir_path="$(dirname "$path")"
+        base_name="$(basename "$path")"
+        mkdir -p "$dir_path"
+        (
+            cd "$dir_path"
+            printf '%s/%s\n' "$(pwd -P)" "$base_name"
+        )
+        return 0
+    fi
+
+    (
+        cd "$path"
+        pwd -P
+    )
+}
+
+resolve_llvm_link() {
+    local candidate
+
+    if [ -n "$LLVM_LINK" ]; then
+        printf '%s\n' "$LLVM_LINK"
+        return 0
+    fi
+
+    for candidate in \
+        "$(command -v llvm-link-15 2>/dev/null || true)" \
+        /tmp/llvm-150-install_O_D_A/bin/llvm-link \
+        "$(command -v llvm-link 2>/dev/null || true)"
+    do
+        if [ -n "$candidate" ] && [ -x "$candidate" ] && \
+           "$candidate" --version 2>/dev/null | grep -q 'LLVM version 15'; then
+            printf '%s\n' "$candidate"
+            return 0
+        fi
+    done
+
+    return 1
+}
+
+usage() {
+    echo "Usage: $0 -syzspec path -kernsrc path -outdir path -subsystem name[,name...]|all"
+    echo ""
+    echo "  -syzspec   - Path to SyzSpec root (e.g., /vol/fuzzer/SyzSpec)"
+    echo "  -kernsrc   - Path to kernel source compiled with LLVM bitcode"
+    echo "  -outdir    - Output directory for generated specs"
+    echo "  -subsystem - Required subsystem name, comma-separated list, or all"
+    echo ""
+    echo "Available subsystems:"
+    echo "  all $ALL_SUBSYSTEMS"
+}
+
+has_word() {
+    case " $1 " in
+        *" $2 "*) return 0 ;;
+        *) return 1 ;;
+    esac
+}
+
+should_run_subsystem() {
+    has_word "$SELECTED_SUBSYSTEMS" "$1"
+}
+
+mark_launched() {
+    if ! has_word "$LAUNCHED_SUBSYSTEMS" "$1"; then
+        LAUNCHED_SUBSYSTEMS="$LAUNCHED_SUBSYSTEMS $1"
+    fi
+}
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        -syzspec)
+            if [ -z "$2" ]; then
+                echo "Error: -syzspec requires an argument"
+                usage
+                exit 1
+            fi
+            SYZSPEC="$2"
+            shift 2
+            ;;
+        -kernsrc)
+            if [ -z "$2" ]; then
+                echo "Error: -kernsrc requires an argument"
+                usage
+                exit 1
+            fi
+            KERNSRC="$2"
+            shift 2
+            ;;
+        -outdir)
+            if [ -z "$2" ]; then
+                echo "Error: -outdir requires an argument"
+                usage
+                exit 1
+            fi
+            OUTDIR="$2"
+            shift 2
+            ;;
+        -subsystem)
+            if [ -z "$2" ]; then
+                echo "Error: -subsystem requires an argument"
+                usage
+                exit 1
+            fi
+            SELECTED_SUBSYSTEMS="${2//,/ }"
+            shift 2
+            ;;
+        -h|--help)
+            usage
+            exit 0
+            ;;
+        *)
+            echo "Error: unknown argument: $1"
+            usage
+            exit 1
+            ;;
+    esac
+done
+
+if [ -z "$SELECTED_SUBSYSTEMS" ]; then
+    echo "Error: -subsystem is required"
+    usage
+    exit 1
+fi
+
+if has_word "$SELECTED_SUBSYSTEMS" "all"; then
+    SELECTED_SUBSYSTEMS="$ALL_SUBSYSTEMS"
+else
+    for subsystem in $SELECTED_SUBSYSTEMS; do
+        if ! has_word "$ALL_SUBSYSTEMS" "$subsystem"; then
+            echo "Error: unknown subsystem: $subsystem"
+            usage
+            exit 1
+        fi
+    done
+fi
+
+if [ -z "$SYZSPEC" ] || [ -z "$KERNSRC" ] || [ -z "$OUTDIR" ]; then
+    usage
+    exit 1
+fi
+
+SYZSPEC="$(resolve_path "$SYZSPEC")"
+KERNSRC="$(resolve_path "$KERNSRC")"
+OUTDIR="$(resolve_path "$OUTDIR" create)"
+
+KLEE="$SYZSPEC/build/bin/klee"
+LLVM_LINK="$(resolve_llvm_link || true)"
+
+if [ ! -x "$KLEE" ]; then
+    echo "Error: klee binary not found at $KLEE"
+    exit 1
+fi
+
+mkdir -p "$OUTDIR" && cd "$OUTDIR"
+
+###############################################################################
+# autofs - autofs device ioctl (fs/autofs/dev-ioctl.c)
+# Note: Prefer the dev-ioctl translation unit when available to keep the
+# analysis focused on the ioctl entry path and avoid opaque-struct crashes
+# seen with the full built-in.bc on newer kernels.
+###############################################################################
+if should_run_subsystem autofs; then
+mkdir -p autofs && cd autofs
+AUTOFS_BC="$KERNSRC/fs/autofs/dev-ioctl.bc"
+if [ ! -f "$AUTOFS_BC" ]; then
+    AUTOFS_BC="$KERNSRC/fs/autofs/built-in.bc"
+fi
+"$KLEE" \
+    --entry-point=autofs_dev_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_autofs" \
+    --spec-suffix="" \
+    --max-time=24h \
+    --spec-output="autofs" \
+    "$AUTOFS_BC"
+cd ..
+mark_launched autofs
+fi
+
+###############################################################################
+# ax25 - AX.25 amateur radio socket ioctl (net/ax25/af_ax25.c)
+###############################################################################
+if should_run_subsystem ax25; then
+mkdir -p ax25 && cd ax25
+"$KLEE" \
+    --entry-point=ax25_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_ax25" \
+    --spec-suffix="" \
+    --max-time=24h \
+    --spec-output="ax25" \
+    "$KERNSRC"/net/ax25/built-in.bc
+cd ..
+mark_launched ax25
+fi
+
+###############################################################################
+# btrfs - btrfs filesystem ioctl (fs/btrfs/ioctl.c)
+# Note: btrfs ioctl pulls in VFS idmap, namespace-tree, sysctl, and xattr
+# globals whose real definitions live outside ioctl.bc. Linking this targeted
+# set avoids the opaque-struct crash seen with plain ioctl.bc/built-in.bc.
+###############################################################################
+if should_run_subsystem btrfs; then
+mkdir -p btrfs && cd btrfs
+BTRFS_BC="$(pwd)/btrfs_ioctl_bundle.bc"
+if [ -z "$LLVM_LINK" ]; then
+    echo "Error: btrfs generation requires llvm-link compatible with LLVM 15 bitcode"
+    echo "Set LLVM_LINK to an llvm-link 15 binary and rerun the script."
+    exit 1
+fi
+
+BTRFS_LINK_INPUTS=(
+    "$KERNSRC/fs/btrfs/ioctl.bc"
+    "$KERNSRC/fs/btrfs/file.bc"
+    "$KERNSRC/fs/btrfs/inode.bc"
+    "$KERNSRC/fs/btrfs/super.bc"
+    "$KERNSRC/fs/btrfs/xattr.bc"
+    "$KERNSRC/fs/mnt_idmapping.bc"
+    "$KERNSRC/fs/namespace.bc"
+    "$KERNSRC/fs/namei.bc"
+    "$KERNSRC/fs/open.bc"
+    "$KERNSRC/fs/ioctl.bc"
+    "$KERNSRC/fs/read_write.bc"
+    "$KERNSRC/kernel/nstree.bc"
+    "$KERNSRC/kernel/nscommon.bc"
+    "$KERNSRC/kernel/sysctl.bc"
+)
+
+for btrfs_input in "${BTRFS_LINK_INPUTS[@]}"; do
+    if [ ! -f "$btrfs_input" ]; then
+        echo "Error: missing required btrfs link input: $btrfs_input"
+        exit 1
+    fi
+done
+
+echo "btrfs: linking targeted bitcode bundle for ioctl analysis..."
+"$LLVM_LINK" -o "$BTRFS_BC" "${BTRFS_LINK_INPUTS[@]}"
+
+"$KLEE" \
+    --entry-point=btrfs_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_btrfs" \
+    --spec-suffix="" \
+    --max-time=24h \
+    --spec-output="btrfs" \
+    "$BTRFS_BC"
+cd ..
+mark_launched btrfs
+fi
+
+###############################################################################
+# can - CAN BCM sendmsg (net/can/bcm.c)
+# Note: CAN sockets do not implement a custom ioctl handler. The BCM
+# (Broadcast Manager) sendmsg interface is the primary command entry point.
+# Prefer bcm.bc when available so KLEE only sees the relevant entry module.
+###############################################################################
+if should_run_subsystem can; then
+mkdir -p can && cd can
+CAN_BC="$KERNSRC/net/can/bcm.bc"
+if [ ! -f "$CAN_BC" ]; then
+    CAN_BC="$KERNSRC/net/can/built-in.bc"
+fi
+"$KLEE" \
+    --entry-point=bcm_sendmsg \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=sendmsg \
+    --spec-prefix="fd fd_syzspec_can_bcm" \
+    --spec-suffix="" \
+    --max-time=24h \
+    --spec-output="can" \
+    "$CAN_BC"
+cd ..
+mark_launched can
+fi
+
+###############################################################################
+# comedi - Comedi data acquisition ioctl (drivers/comedi/comedi_fops.c)
+###############################################################################
+if should_run_subsystem comedi; then
+mkdir -p comedi && cd comedi
+"$KLEE" \
+    --entry-point=comedi_unlocked_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_comedi" \
+    --spec-suffix="" \
+    --max-time=24h \
+    --spec-output="comedi" \
+    "$KERNSRC"/drivers/comedi/built-in.bc
+cd ..
+mark_launched comedi
+fi
+
+###############################################################################
+# dri - DRM/DRI ioctl (drivers/gpu/drm/drm_ioctl.c)
+# Note: Prefer drm_ioctl.bc to avoid pulling the entire DRM core into the
+# initial module when the ioctl entry point lives in a single translation unit.
+###############################################################################
+if should_run_subsystem dri; then
+mkdir -p dri && cd dri
+DRI_BC="$KERNSRC/drivers/gpu/drm/drm_ioctl.bc"
+if [ ! -f "$DRI_BC" ]; then
+    DRI_BC="$KERNSRC/drivers/gpu/drm/built-in.bc"
+fi
+"$KLEE" \
+    --entry-point=drm_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_dri" \
+    --spec-suffix="" \
+    --max-time=24h \
+    --spec-output="dri" \
+    "$DRI_BC"
+cd ..
+mark_launched dri
+fi
+
+###############################################################################
+# f2fs - F2FS filesystem ioctl (fs/f2fs/file.c)
+# Note: Prefer file.bc because f2fs_ioctl is implemented in file.c.
+###############################################################################
+if should_run_subsystem f2fs; then
+mkdir -p f2fs && cd f2fs
+F2FS_BC="$KERNSRC/fs/f2fs/file.bc"
+if [ ! -f "$F2FS_BC" ]; then
+    F2FS_BC="$KERNSRC/fs/f2fs/built-in.bc"
+fi
+"$KLEE" \
+    --entry-point=f2fs_ioctl \
+    --spec-arguments-index=1 \
+    --spec-arguments-num=2 \
+    --spec-interface-name=ioctl \
+    --spec-prefix="fd fd_syzspec_f2fs" \
+    --spec-suffix="" \
+    --max-time=24h \
+    --spec-output="f2fs" \
+    "$F2FS_BC"
+cd ..
+mark_launched f2fs
+fi
+
+###############################################################################
+# fuse - FUSE device ioctl (fs/fuse/dev.c)
