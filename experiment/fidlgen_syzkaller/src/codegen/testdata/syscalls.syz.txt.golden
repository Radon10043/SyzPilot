#
# Zircon system call descriptions for syzkaller, in syzlang:
# https://github.com/google/syzkaller/blob/master/docs/syscall_descriptions_syntax.md
#
# WARNING: This file is machine generated by fidlgen_syzkaller from the FIDL
# declarations of the Zircon vDSO (FIDL library zx). DO NOT EDIT.
#
# Constants are inlined numerically, so this description is self-contained: it
# needs no Zircon headers and hence no syz-extract run.
#
# fidl_experiment = zx_c_types
#
# Notes on this translation:
# - some untyped handle parameters were typed after the object their syscall operates on; pass -infer-handle-subtypes=false to keep them untyped

## Handles and other values passed between system calls.

resource zx_handle[int32]: 0
resource zx_chan[zx_handle]
resource zx_clock[zx_handle]
resource zx_port[zx_handle]
resource zx_time[int64]: 0, 0x7fffffffffffffff

## Enums and bitfields.

# zx/Rights: DUPLICATE=1, TRANSFER=2, READ=4, WRITE=8, EXECUTE=16, MAP=32, GET_PROPERTY=64, SET_PROPERTY=128, ENUMERATE=256, DESTROY=512, SET_POLICY=1024, GET_POLICY=2048, SIGNAL=4096, SIGNAL_PEER=8192, WAIT=16384, INSPECT=32768, MANAGE_JOB=65536, MANAGE_PROCESS=131072, MANAGE_THREAD=262144, APPLY_PROFILE=524288, MANAGE_SOCKET=1048576, OP_CHILDREN=2097152, RESIZE=4194304, ATTACH_VMO=8388608, MANAGE_VMO=16777216, SAME_RIGHTS=2147483648
zx_rights = 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608, 16777216, 2147483648

## Types passed to system calls by reference.

# zx/ChannelCallArgs (opaque: the FIDL declaration has no members)
zx_channel_call_args {
	opaque  int8
}

# zx/PacketException
zx_packet_exception {
	pid        int64
	tid        int64
	reserved0  int64
	reserved1  int64
}

# zx/PacketGuestBell
zx_packet_guest_bell {
	addr       intptr
	reserved0  int64
	reserved1  int64
	reserved2  int64
}

# zx/PacketGuestIo
zx_packet_guest_io {
	port         int16
	access_size  int8
	input        int8
	reserved0    int64
	reserved1    int64
	reserved2    int64
}

# zx/PacketGuestMem
zx_packet_guest_mem {
	addr  intptr
}

# zx/PacketGuestVcpu
zx_packet_guest_vcpu {
	type      int8
	reserved  int64
}

# zx/PacketInterrupt
zx_packet_interrupt {
	timestamp  zx_time
	reserved0  int64
	reserved1  int64
	reserved2  int64
}

# zx/PacketPageRequest
zx_packet_page_request {
	command    int16
	flags      int16
	reserved0  int32
	offset     int64
	length     int64
	reserved1  int64
}

# zx/PacketProcessorPowerLevelTransitionRequest
zx_packet_processor_power_level_transition_request {
	domain_id          int32
	options            int32
	control_argument   int64
	control_interface  int64
	reserved           int64
}

# zx/PacketSignal
zx_packet_signal {
	trigger    int32
	observed   int32
	count      int64
	timestamp  zx_time
	reserved1  int64
}

# zx/PacketUser
zx_packet_user [
	u64  array[int64, 4]
	u32  array[int32, 8]
	u16  array[int16, 16]
	c8   array[int8, 32]
]

# zx/PortPacket
zx_port_packet {
	key                               int64
	type                              int32
	status                            int32
	user                              zx_packet_user
	signal                            zx_packet_signal
	exception                         zx_packet_exception
	guest_bell                        zx_packet_guest_bell
	guest_mem                         zx_packet_guest_mem
	guest_io                          zx_packet_guest_io
	guest_vcpu                        zx_packet_guest_vcpu
	interrupt                         zx_packet_interrupt
	page_request                      zx_packet_page_request
	processor_power_level_transition  zx_packet_processor_power_level_transition_request
}

## System calls.

# zx/Channel, from zircon/vdso/channel.fidl
zx_channel_create(options int32, out0 ptr[out, zx_chan], out1 ptr[out, zx_chan])
zx_channel_read(handle zx_chan, options int32, bytes ptr[out, array[int8]], handles ptr[out, array[zx_handle]], num_bytes len[bytes], num_handles len[handles], actual_bytes ptr[out, int32], actual_handles ptr[out, int32])
zx_channel_write(handle zx_chan, options int32, bytes ptr[in, array[int8]], num_bytes len[bytes], handles ptr[in, array[zx_handle]], num_handles len[handles])
zx_channel_call(handle zx_chan, options int32, deadline zx_time, args ptr[in, zx_channel_call_args], actual_bytes ptr[out, int32], actual_handles ptr[out, int32])

# zx/Clockfuncs, from zircon/vdso/clock.fidl
zx_clock_get_monotonic() zx_time
zx_clock_create(options int64, args ptr[in, array[int8]], out ptr[out, zx_clock])
zx_clock_read(handle zx_clock, now ptr[out, zx_time])

# zx/Handlefuncs, from zircon/vdso/handle.fidl
zx_handle_close(handle zx_handle)
zx_handle_duplicate(handle zx_handle, rights flags[zx_rights], out ptr[out, zx_handle])

# zx/Misc, from zircon/vdso/misc.fidl
zx_nanosleep(deadline zx_time)
zx_ticks_get() (ignore_return)
zx_deadline_after(nanoseconds int64) zx_time

# zx/Port, from zircon/vdso/port.fidl
zx_port_create(options int32, out ptr[out, zx_port])
zx_port_queue(handle zx_port, packet ptr[in, zx_port_packet])
zx_port_wait(handle zx_port, deadline zx_time, packet ptr[out, zx_port_packet])

# zx/Process, from zircon/vdso/process.fidl
# does not return
zx_process_exit(retcode int64) (disabled)
