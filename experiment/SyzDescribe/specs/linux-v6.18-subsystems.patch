+++ b/script/genspec.sh
@@ -0,0 +1,119 @@
+#!/bin/bash
+
+# this script is used to generate spec via SyzDescribe for each kernel bitcode file.
+#
+# usage:
+#   bash ./script/genspec.sh -k <KERNEL_DIR> -o <OUTDIR>
+#
+# skills:
+#   kill all related process: pkill genspec.sh; pkill SyzDescribe
+
+set -euo pipefail
+
+# required args
+KERNEL_DIR=
+OUTDIR=
+
+# optional args
+TIMEOUT_DURATION="20m"
+
+print_help() {
+    echo "usage: $0 [ARGS]"
+    echo "  args (required):"
+    echo "    -k, --kernel <PATH>       Path to the kernel source directory"
+    echo "    -o, --outdir <PATH>       Path to the output directory"
+    echo "  args (optional):"
+    echo "    -t, --timeout <DURATION>  Timeout duration for SyzDescribe (default: 20m)"
+    echo "    -h, --help                Show this help message and exit"
+}
+
+REPO_DIR=$(realpath $(dirname "$0")/..)
+SYZDESCRIBE_BIN="$REPO_DIR"/build/tools/SyzDescribe/SyzDescribe
+BLACKLIST=(
+    "drivers/built-in.bc"
+)
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        -k|--kernel)
+            KERNEL_DIR="$2"
+            shift 2
+            ;;
+        -o|--outdir)
+            OUTDIR="$2"
+            shift 2
+            ;;
+        -h|--help)
+            print_help
+            exit 0
+            ;;
+        -t|--timeout)
+            TIMEOUT_DURATION="$2"
+            shift 2
+            ;;
+        *)
+            echo "Unknown argument: $1"
+            print_help
+            exit 1
+            ;;
+    esac
+done
+
+if [[ -z "$KERNEL_DIR" ]]; then
+    echo "Error: Kernel directory is required."
+    print_help
+    exit 1
+fi
+
+if [[ -z "$OUTDIR" ]]; then
+    echo "Error: Output directory is required."
+    print_help
+    exit 1
+fi
+
+mapfile -t bc_paths < <(find "$KERNEL_DIR" -type f -name "*.bc" | sort)
+total_bc=${#bc_paths[@]}
+
+mkdir -p $OUTDIR
+for i in "${!bc_paths[@]}"; do
+    bc_path="${bc_paths[$i]}"
+    cur_time=$(date +"%Y-%m-%d %H:%M:%S")
+    echo -n "[$cur_time][$((i+1))/$total_bc] Processing $bc_path ... "
+
+    for bl in "${BLACKLIST[@]}"; do
+        bl_path=$(realpath "$KERNEL_DIR/$bl")
+        if [[ "$bc_path" == "$bl_path" ]]; then
+            echo "blacklisted"
+            continue 2
+        fi
+    done
+
+    hash=$(echo -n "$bc_path" | md5sum | cut -d' ' -f1)
+    workdir="$OUTDIR/$hash"
+    if [[ -d "$workdir" ]]; then
+        echo "skip"
+        continue
+    fi
+
+    mkdir $workdir && cd $workdir
+
+    cat <<__EOF__ > config.json
+{
+    "bitcode": "$bc_path",
+    "knowledge": "$REPO_DIR/config/knowledge.json",
+    "version": "cloudexp"
+}
+__EOF__
+
+    if timeout "$TIMEOUT_DURATION" "$SYZDESCRIBE_BIN" --config=config.json > /dev/null 2>&1; then
+        echo "success"
+    else
+        exit_code=$?
+        if [[ $exit_code -eq 124 ]]; then
+            echo "timeout"
+        else
+            echo "failed (exit code: $exit_code)"
+        fi
+    fi
+    cd - > /dev/null
+done
