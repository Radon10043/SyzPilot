+#ifdef TARGET_ANDROID
+const std::filesystem::path output_directory = std::filesystem::current_path();
+#endif
+
+#ifdef TARGET_ANDROID
+static bool is_dependency_output_arg(llvm::StringRef arg) {
+  if (arg == "-M" || arg == "-MM" || arg == "-MD" || arg == "-MMD" ||
+      arg == "-MG" || arg == "-MP" || arg.starts_with("-MF") ||
+      arg.starts_with("-MT") || arg.starts_with("-MQ")) {
+    return true;
+  }
+
+  return arg.starts_with("-Wp,") &&
+         (arg.contains("-MMD") || arg.contains("-MD") ||
+          arg.contains("-MF"));
+}
+
+static bool dependency_output_arg_takes_value(llvm::StringRef arg) {
+  return arg == "-MF" || arg == "-MT" || arg == "-MQ";
+}
+#endif
+
+int default_job_count() {
+  unsigned threads = std::thread::hardware_concurrency();
+  if (threads == 0) {
+    return 8;
+  }
+  if (threads > 32) {
+    return 32;
+  }
+  return static_cast<int>(threads);
+}
 
