# Android common kernel options needed to boot the SyzGen++ Debian/QEMU VM.
# This matches syzgen/vm/qemu.py's default device model:
#   -hda <bullseye.img>
#   root=/dev/sda
#   console=ttyS0
#   -device e1000

# Basic QEMU/x86 guest support.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Root disk support for "-hda ... root=/dev/sda".
# These must be built in, not modules, because they are needed before rootfs.
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_ATA_GENERIC=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# Root filesystem and early device nodes.
CONFIG_EXT4_FS=y
CONFIG_JBD2=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# Serial console used by QEMU and SyzGen++ logs.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Networking for SSH over QEMU user networking with "-device e1000".
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y

# SyzGen++ runtime hook and analysis requirements.
CONFIG_MODULES=y
CONFIG_KPROBES=y
CONFIG_FUNCTION_TRACER=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF4=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
CONFIG_DEBUG_INFO_COMPRESSED_NONE=y
# CONFIG_DEBUG_INFO_COMPRESSED_ZSTD is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
CONFIG_KCOV=y
CONFIG_KCOV_ENABLE_COMPARISONS=y
CONFIG_KCOV_INSTRUMENT_ALL=y
CONFIG_KASAN=y

# Keep runtime addresses stable and avoid Android's ttynull default.
# On x86 this built-in command line is appended to QEMU's -append string
# unless CMDLINE_OVERRIDE is enabled.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0 earlyprintk=serial net.ifnames=0 root=/dev/sda rw rootwait nokaslr"
# CONFIG_CMDLINE_OVERRIDE is not set
# CONFIG_RANDOMIZE_BASE is not set

# Make external hook.ko builds less fragile outside the Android Kleaf flow.
# CONFIG_WERROR is not set
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set
