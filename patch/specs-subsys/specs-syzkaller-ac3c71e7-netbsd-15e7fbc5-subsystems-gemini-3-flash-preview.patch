+	pad			int8
+
+	tcpi_rto		int32
+	__tcpi_ato		int32
+	tcpi_snd_mss		int32
+	tcpi_rcv_mss		int32
+
+	__tcpi_unacked		int32
+	__tcpi_sacked		int32
+	__tcpi_lost		int32
+	__tcpi_retrans		int32
+	__tcpi_fackets		int32
+
+	__tcpi_last_data_sent	int32
+	__tcpi_last_ack_sent	int32
+	tcpi_last_data_recv	int32
+	__tcpi_last_ack_recv	int32
+
+	__tcpi_pmtu		int32
+	__tcpi_rcv_ssthresh	int32
+	tcpi_rtt		int32
+	tcpi_rttvar		int32
+	tcpi_snd_ssthresh	int32
+	tcpi_snd_cwnd		int32
+	__tcpi_advmss		int32
+	__tcpi_reordering	int32
+
+	__tcpi_rcv_rtt		int32
+	tcpi_rcv_space		int32
+
+# BSD Extensions
+	tcpi_snd_wnd		int32
+	tcpi_snd_bwnd		int32
+	tcpi_snd_nxt		int32
+	tcpi_rcv_nxt		int32
+	tcpi_toe_tid		int32
