+	__tcpi_probes		int8
+	__tcpi_backoff		int8
+	tcpi_options		int8
+# tcpi_snd_wscale:4 and tcpi_rcv_wscale:4 share one byte
+	tcpi_wscales		int8
+# Padding for alignment (NetBSD uint8_t fields are followed by uint32_t)
+# The C struct has 7 uint8_t fields, then bitfields.
+# Total 8 bytes of 8-bit values before the first uint32_t.
+# tcpi_state(1) + ca(1) + retrans(1) + probes(1) + backoff(1) + options(1) + wscales(1) = 7 bytes.
