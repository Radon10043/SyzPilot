+
+#define SYZKALLER_FUCHSIA_COMPAT_UNUSED __attribute__((unused))
+
+static void SYZKALLER_FUCHSIA_COMPAT_UNUSED remove_dir(const char* dir)
+{
+	DIR* dp = opendir(dir);
+	if (dp == nullptr) {
+		rmdir(dir);
+		return;
+	}
+	struct dirent* ep = nullptr;
+	while ((ep = readdir(dp)) != nullptr) {
+		if (!strcmp(ep->d_name, ".") || !strcmp(ep->d_name, ".."))
+			continue;
+		char filename[1024];
+		snprintf(filename, sizeof(filename), "%s/%s", dir, ep->d_name);
+		struct stat st;
+		if (lstat(filename, &st))
+			continue;
+		if (S_ISDIR(st.st_mode))
+			remove_dir(filename);
+		else
+			unlink(filename);
+	}
+	closedir(dp);
+	rmdir(dir);
+}
+
+static zx_handle_t SYZKALLER_FUCHSIA_COMPAT_UNUSED get_root_resource()
+{
