+# Copyright 2025 The Fuchsia Authors. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//build/rust/rustc_library.gni")
+
+# The SanitizerCoverage callbacks the instrumented Starnix crates call into.
+# Deliberately not built with `kernel_library_config`: instrumenting the
+# instrumentation would make the callback recurse into itself.
+static_library("runtime") {
+  sources = [ "sancov.cc" ]
+
+  # Any binary linking instrumented Starnix crates needs this, see
+  # //src/starnix/build:sancov.
+  visibility = [
+    ":*",
+    "//src/starnix/runner:*",
+  ]
+}
+
+rustc_library("starnix_sancov") {
+  name = "starnix_sancov"
+  edition = "2024"
+  version = "0.1.0"
+  sources = [ "src/lib.rs" ]
+  deps = [
+    "//sdk/rust/zx",
+    "//src/lib/fuchsia-runtime",
+    "//third_party/rust_crates:log",
+  ]
+  non_rust_deps = [ ":runtime" ]
+}
diff --git a/src/starnix/lib/starnix_sancov/sancov.cc b/src/starnix/lib/starnix_sancov/sancov.cc
new file mode 100644
index 00000000000..c13ecc3c6b8
--- /dev/null
+++ b/src/starnix/lib/starnix_sancov/sancov.cc
@@ -0,0 +1,123 @@
+// Copyright 2025 The Fuchsia Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <atomic>
+
+// SanitizerCoverage runtime for the Starnix kernel.
+//
+// When the `starnix_sancov` build arg is set, the Starnix crates are compiled
+// with `-sanitizer-coverage-trace-pc-guard`, which makes every instrumented
+// basic block call __sanitizer_cov_trace_pc_guard() with a pointer to its own
+// slot in the linker-merged __sancov_guards section.
+//
+// This file must never be instrumented itself, otherwise the callback would
+// recurse infinitely.  That holds as long as instrumentation is only added
+// through rustflags, which do not affect C++.
+//
+// The data is kept in the wire format used by the Zircon kernel, see
+// //zircon/kernel/lib/instrumentation/sancov.cc: a magic number followed by one
+// word per instrumented PC.  The buffers themselves are allocated by the Rust
+// side (see lib.rs) out of VMOs so that they can be handed to Linux programs
+// running in the container, which read them to collect coverage.
+
+extern "C" {
+
+// Bounds of the guard section.  These are provided by the linker and are both
+// null when nothing at all was instrumented.
+[[gnu::weak]] extern uint32_t __start___sancov_guards[];
+[[gnu::weak]] extern uint32_t __stop___sancov_guards[];
+
+// Start of this executable's image, used to convert runtime PCs into the
+// link-time addresses that the consumer of the data expects.
+extern const char __ehdr_start[];
+
+}  // extern "C"
+
+namespace {
+
+constexpr uint64_t kPcMagic = 0xC0BFFFFFFFFFFF64ULL;
+constexpr uint64_t kCountsMagic = 0x0023766f436e6153ULL;  // "SanCov#" (LE)
+
+size_t GuardsCount() {
+  if (__start___sancov_guards == nullptr) {
+    return 0;
+  }
+  return static_cast<size_t>(__stop___sancov_guards - __start___sancov_guards);
+}
+
+// Both remain null until starnix_sancov_set_buffers() publishes the buffers.
+// Instrumented code starts running in static constructors, long before the
+// kernel is able to allocate anything, so until then hits are accumulated in
+// the guard slots and transferred when the buffers show up.  Afterwards each
+// guard slot is only a flag telling whether the PC has been recorded yet.
+std::atomic<uint64_t*> g_counts{nullptr};
+uint64_t* g_pcs = nullptr;
+
+}  // namespace
+
+extern "C" {
+
+// Called from a constructor of every instrumented object file.  LLVM passes the
+// bounds of the whole merged section every time, and indices are derived from
+// the guard address directly, so there is nothing to record here.
+void __sanitizer_cov_trace_pc_guard_init(uint32_t* start, uint32_t* stop) {}
+
+// Called from every instrumented basic block.
+void __sanitizer_cov_trace_pc_guard(uint32_t* guard) {
+  uint64_t* counts = g_counts.load(std::memory_order_acquire);
+  if (counts == nullptr) [[unlikely]] {
+    // Pre-initialization; count the hit in the guard slot itself.
+    ++*guard;
+    return;
+  }
+
+  // Slot 0 of each buffer holds the magic number, so the tables are offset by
+  // one from the guard section.
+  const size_t idx = static_cast<size_t>(guard - __start___sancov_guards) + 1;
+  __atomic_fetch_add(&counts[idx], 1, __ATOMIC_RELAXED);
+
+  // Use the guard as a flag indicating whether the PC has been stored, so that
+  // only the first thread through this block pays for the store.
+  if (__atomic_load_n(guard, __ATOMIC_RELAXED) == 0 &&
+      __atomic_exchange_n(guard, 1u, __ATOMIC_RELAXED) == 0) [[unlikely]] {
+    // Record the return address, which is what coverage consumers expect: they
+    // step back one instruction themselves to get to the call site. Rebase it
+    // to a link-time address so that they need no further adjustment.
+    g_pcs[idx] = reinterpret_cast<uintptr_t>(__builtin_return_address(0)) -
+                 reinterpret_cast<uintptr_t>(__ehdr_start);
+  }
+}
+
+// Number of instrumented PCs, i.e. the number of entries that follow the magic
+// number in each buffer.  Zero if the kernel was built without instrumentation.
+size_t starnix_sancov_guards_count() { return GuardsCount(); }
+
+// Hands the runtime the two buffers to record into, each of which must hold at
+// least starnix_sancov_guards_count() + 1 words and stay mapped forever.
+// Returns false if there is nothing to record or if buffers were already set.
+bool starnix_sancov_set_buffers(uint64_t* counts, uint64_t* pcs) {
+  const size_t count = GuardsCount();
+  if (count == 0 || g_counts.load(std::memory_order_relaxed) != nullptr) {
+    return false;
+  }
+
+  counts[0] = kCountsMagic;
+  pcs[0] = kPcMagic;
+
+  // Move the hits accumulated in the guard slots to their real home and reset
+  // the guards to their post-initialization meaning.  PCs whose only hits
+  // happened before this point keep a zero PC slot, which consumers skip.
+  for (size_t i = 0; i < count; ++i) {
+    counts[i + 1] = __atomic_exchange_n(&__start___sancov_guards[i], 0u, __ATOMIC_RELAXED);
+  }
+
+  g_pcs = pcs;
+  g_counts.store(counts, std::memory_order_release);
+  return true;
+}
+
+}  // extern "C"
diff --git a/src/starnix/lib/starnix_sancov/src/lib.rs b/src/starnix/lib/starnix_sancov/src/lib.rs
new file mode 100644
index 00000000000..be5dcdbf4d4
--- /dev/null
+++ b/src/starnix/lib/starnix_sancov/src/lib.rs
@@ -0,0 +1,113 @@
+// Copyright 2025 The Fuchsia Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Owns the buffers that the Starnix kernel's SanitizerCoverage runtime records
+//! into, and hands out read-only VMOs for them.
+//!
+//! The kernel is instrumented when it is built with `starnix_sancov = true`;
+//! otherwise there are no instrumented PCs and everything here is inert. See
+//! `sancov.cc` for the runtime itself and `//src/starnix/modules/procfs` for
+//! how the tables reach programs running in the container.
+
+use std::sync::OnceLock;
+use zx::HandleBased as _;
+
+unsafe extern "C" {
+    fn starnix_sancov_guards_count() -> usize;
+    fn starnix_sancov_set_buffers(counts: *mut u64, pcs: *mut u64) -> bool;
+}
+
+/// Read-only handles to the live coverage tables.
+///
+/// Both tables have the same layout: a magic number followed by one word per
+/// instrumented PC. The counts table holds a hit counter for each PC, the PC
+/// table holds that PC as a link-time address (zero until the PC is first hit).
+pub struct SancovTables {
+    pcs: zx::Vmo,
+    counts: zx::Vmo,
+    size: u64,
+}
+
+impl SancovTables {
+    /// Size of each table in bytes.
+    pub fn size(&self) -> u64 {
+        self.size
+    }
+
+    /// A read-only handle to the PC table.
+    pub fn pcs_vmo(&self) -> Result<zx::Vmo, zx::Status> {
+        self.pcs.duplicate_handle(zx::Rights::SAME_RIGHTS)
+    }
+
+    /// A read-only handle to the hit counter table.
+    pub fn counts_vmo(&self) -> Result<zx::Vmo, zx::Status> {
+        self.counts.duplicate_handle(zx::Rights::SAME_RIGHTS)
+    }
+}
+
+static TABLES: OnceLock<Option<SancovTables>> = OnceLock::new();
+
+/// Allocates the coverage tables and starts recording into them.
+///
+/// Hits from before this call are not lost: the runtime accumulates them in the
+/// guard slots and moves them over here. Does nothing if the kernel was not
+/// built with instrumentation, and is idempotent.
+pub fn init() {
+    tables();
+}
+
+/// The coverage tables, or `None` if the kernel is not instrumented.
+pub fn tables() -> Option<&'static SancovTables> {
+    TABLES
+        .get_or_init(|| match create() {
+            Ok(tables) => tables,
+            Err(status) => {
+                log::warn!("failed to set up Starnix sancov tables: {status}");
+                None
+            }
+        })
+        .as_ref()
+}
+
+fn create() -> Result<Option<SancovTables>, zx::Status> {
+    // SAFETY: the runtime only reads linker-provided section bounds.
+    let count = unsafe { starnix_sancov_guards_count() };
+    if count == 0 {
+        return Ok(None);
+    }
+    let size = ((count + 1) * std::mem::size_of::<u64>()) as u64;
+
+    let (counts_vmo, counts_addr) = map_table(size, "starnix:sancov-counts")?;
+    let (pcs_vmo, pcs_addr) = map_table(size, "starnix:sancov-pcs")?;
+
+    // SAFETY: both mappings are `size` bytes long, which is what the runtime
+    // was told to expect, and they are never unmapped.
+    if !unsafe { starnix_sancov_set_buffers(counts_addr as *mut u64, pcs_addr as *mut u64) } {
+        return Ok(None);
+    }
+
+    // The writable handles are dropped here; the mappings keep the VMOs alive.
+    Ok(Some(SancovTables {
+        pcs: read_only(&pcs_vmo)?,
+        counts: read_only(&counts_vmo)?,
+        size,
+    }))
+}
+
+/// Creates a VMO of `size` bytes and maps it read-write for the lifetime of the
+/// process, returning the VMO and the address it was mapped at.
+fn map_table(size: u64, name: &str) -> Result<(zx::Vmo, usize), zx::Status> {
+    let vmo = zx::Vmo::create(size)?;
+    vmo.set_name(&zx::Name::new_lossy(name))?;
+    let flags = zx::VmarFlags::PERM_READ
+        | zx::VmarFlags::PERM_WRITE
+        | zx::VmarFlags::REQUIRE_NON_RESIZABLE;
+    let addr = fuchsia_runtime::vmar_root_self().map(0, &vmo, 0, size as usize, flags)?;
+    Ok((vmo, addr))
+}
+
+fn read_only(vmo: &zx::Vmo) -> Result<zx::Vmo, zx::Status> {
+    let rights = vmo.basic_info()?.rights.difference(zx::Rights::WRITE);
+    vmo.duplicate_handle(rights)
+}
