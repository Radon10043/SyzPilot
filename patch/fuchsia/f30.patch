diff --git a/src/starnix/modules/procfs/sancov.rs b/src/starnix/modules/procfs/sancov.rs
new file mode 100644
index 00000000000..362ad6a2df9
--- /dev/null
+++ b/src/starnix/modules/procfs/sancov.rs
@@ -0,0 +1,39 @@
+// Copyright 2025 The Fuchsia Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+use starnix_core::mm::memory::MemoryObject;
+use starnix_core::vfs::pseudo::simple_directory::SimpleDirectory;
+use starnix_core::vfs::{FileSystemHandle, FsNodeHandle, MemoryRegularNode};
+use starnix_uapi::file_mode::mode;
+use std::sync::Arc;
+
+/// Creates `/proc/starnix_sancov`, which exposes the kernel's SanitizerCoverage
+/// tables to programs running in the container.
+///
+/// Returns `None` unless the kernel was built with `starnix_sancov = true`.
+///
+/// Both files are backed by the live VMOs the kernel records into, so a fuzzer
+/// can mmap them once and watch the counters change without any further
+/// syscalls -- which matters both for speed and because reading the files
+/// through the kernel would itself show up as coverage.
+pub fn starnix_sancov_directory(fs: &FileSystemHandle) -> Option<FsNodeHandle> {
+    let tables = starnix_sancov::tables()?;
+    let pcs = tables.pcs_vmo().ok()?;
+    let counts = tables.counts_vmo().ok()?;
+
+    let dir = SimpleDirectory::new();
+    dir.edit(fs, |dir| {
+        dir.entry(
+            "pcs",
+            MemoryRegularNode::from_memory(Arc::new(MemoryObject::from(pcs))),
+            mode!(IFREG, 0o444),
+        );
+        dir.entry(
+            "counts",
+            MemoryRegularNode::from_memory(Arc::new(MemoryObject::from(counts))),
+            mode!(IFREG, 0o444),
+        );
+    });
+    Some(dir.into_node(fs, 0o555))
+}
