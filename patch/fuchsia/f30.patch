+#ifndef SRC_TESTING_FUZZING_SYZKALLER_COMPAT_FUCHSIA_SYSCALL_COMPAT_H_
+#define SRC_TESTING_FUZZING_SYZKALLER_COMPAT_FUCHSIA_SYSCALL_COMPAT_H_
+
+#include <stdint.h>
+#include <dirent.h>
+#include <stdio.h>
