diff --git a/src/testing/fuzzing/syzkaller/files.h b/src/testing/fuzzing/syzkaller/files.h
new file mode 100644
index 00000000000..297aab56f24
--- /dev/null
+++ b/src/testing/fuzzing/syzkaller/files.h
@@ -0,0 +1,98 @@
+// Copyright 2026 The Fuchsia Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#if !GOOS_fuchsia
+#include_next "files.h"
+#else
+
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <glob.h>
+#include <stdarg.h>
+#include <string.h>
+#include <unistd.h>
+
+static std::vector<std::string> Glob(const std::string& pattern)
+{
+	glob_t buf = {};
+	int res = glob(pattern.c_str(), GLOB_MARK | GLOB_NOSORT, nullptr, &buf);
+	if (res != 0 && res != GLOB_NOMATCH)
+		failmsg("glob failed", "pattern='%s' res=%d", pattern.c_str(), res);
+	std::vector<std::string> files;
+	for (size_t i = 0; i < buf.gl_pathc; i++) {
+		const char* file = buf.gl_pathv[i];
+		if (file[strlen(file) - 1] == '/')
+			continue;
+		files.push_back(file);
+	}
+	globfree(&buf);
+	debug("glob %s resolved to %zu files\n", pattern.c_str(), files.size());
+	return files;
+}
+
+static std::unique_ptr<rpc::FileInfoRawT> ReadFile(const std::string& file)
+{
+	auto info = std::make_unique<rpc::FileInfoRawT>();
+	info->name = file;
+	int fd = open(file.c_str(), O_RDONLY);
+	if (fd == -1) {
+		info->exists = errno != EEXIST && errno != ENOENT;
+		info->error = strerror(errno);
+	} else {
+		info->exists = true;
+		for (;;) {
+			constexpr size_t kChunk = 4 << 10;
+			info->data.resize(info->data.size() + kChunk);
+			ssize_t n = read(fd, info->data.data() + info->data.size() - kChunk, kChunk);
+			if (n < 0) {
+				info->error = strerror(errno);
+				break;
+			}
+			info->data.resize(info->data.size() - kChunk + n);
+			if (n == 0)
+				break;
+		}
+		close(fd);
+	}
+	debug("reading file %s: size=%zu exists=%d error=%s\n",
+	      info->name.c_str(), info->data.size(), info->exists, info->error.c_str());
+	return info;
+}
+
+static std::string ReadTextFile(const char* file_fmt, ...)
+{
+	char file[1024];
+	va_list args;
+	va_start(args, file_fmt);
+	vsnprintf(file, sizeof(file), file_fmt, args);
+	va_end(args);
+	file[sizeof(file) - 1] = 0;
+	auto data = ReadFile(file)->data;
+	std::string str(data.begin(), data.end());
+	while (!str.empty() && (str.back() == '\n' || str.back() == 0))
+		str.resize(str.size() - 1);
+	return str;
+}
+
+static std::vector<std::unique_ptr<rpc::FileInfoRawT>> ReadFiles(const std::vector<std::string>& files)
+{
+	std::vector<std::unique_ptr<rpc::FileInfoRawT>> results;
+	for (const auto& file : files) {
+		if (!strchr(file.c_str(), '*')) {
+			results.push_back(ReadFile(file));
+			continue;
+		}
+		for (const auto& match : Glob(file))
+			results.push_back(ReadFile(match));
+	}
+	return results;
+}
+
+#endif
diff --git a/src/testing/fuzzing/syzkaller/subprocess.h b/src/testing/fuzzing/syzkaller/subprocess.h
new file mode 100644
index 00000000000..104aca727d4
--- /dev/null
+++ b/src/testing/fuzzing/syzkaller/subprocess.h
@@ -0,0 +1,108 @@
+// Copyright 2026 The Fuchsia Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#if !GOOS_fuchsia
+#include_next "subprocess.h"
+#else
+
+#include <lib/fdio/spawn.h>
+#include <signal.h>
+#include <string.h>
+#include <unistd.h>
+#include <zircon/syscalls.h>
+#include <zircon/syscalls/object.h>
+
+#include <string>
+#include <vector>
+
+class Subprocess
+{
+public:
+	Subprocess(const char** argv, const std::vector<std::pair<int, int>>& fds)
+	{
+		std::vector<fdio_spawn_action_t> actions;
+		actions.reserve(fds.size());
+		for (auto pair : fds) {
+			if (pair.first == -1)
+				continue;
+			fdio_spawn_action_t action = {};
+			action.action = FDIO_SPAWN_ACTION_CLONE_FD;
+			action.fd.local_fd = pair.first;
+			action.fd.target_fd = pair.second;
+			actions.push_back(action);
+		}
+
+		const char* child_envp[] = {
+		    "ASAN_OPTIONS=handle_segv=0 allow_user_segv_handler=1 detect_leaks=0",
+		    nullptr};
+
+		std::string path = argv[0];
+		if (strchr(path.c_str(), '/') == nullptr)
+			path = "/boot/bin/" + path;
+
+		char err_msg[FDIO_SPAWN_ERR_MSG_MAX_LENGTH] = {};
+		zx_status_t status = fdio_spawn_etc(
+		    ZX_HANDLE_INVALID,
+		    FDIO_SPAWN_CLONE_JOB | FDIO_SPAWN_DEFAULT_LDSVC |
+			FDIO_SPAWN_CLONE_NAMESPACE | FDIO_SPAWN_CLONE_UTC_CLOCK,
+		    path.c_str(), argv, child_envp, actions.size(), actions.data(),
+		    &process_, err_msg);
+		if (status != ZX_OK)
+			failmsg("fdio_spawn_etc failed", "status=%d msg=%s", status, err_msg);
+	}
+
+	~Subprocess()
+	{
+		if (process_ != ZX_HANDLE_INVALID)
+			KillAndWait();
+	}
+
+	int KillAndWait()
+	{
+		if (process_ == ZX_HANDLE_INVALID)
+			fail("subprocess hasn't started or already waited");
+		zx_task_kill(process_);
+		return Wait();
+	}
+
+	int WaitAndKill(uint64 timeout_ms)
+	{
+		if (process_ == ZX_HANDLE_INVALID)
+			fail("subprocess hasn't started or already waited");
+		uint64 start = current_time_ms();
+		for (;;) {
+			zx_status_t status = zx_object_wait_one(process_, ZX_PROCESS_TERMINATED,
+								ZX_TIME_INFINITE_PAST, nullptr);
+			if (status == ZX_OK)
+				return Wait();
+			if (current_time_ms() - start > timeout_ms)
+				zx_task_kill(process_);
+			sleep_ms(10);
+		}
+	}
+
+private:
+	zx_handle_t process_ = ZX_HANDLE_INVALID;
+
+	int Wait()
+	{
+		zx_status_t status = zx_object_wait_one(process_, ZX_PROCESS_TERMINATED,
+							ZX_TIME_INFINITE, nullptr);
+		if (status != ZX_OK)
+			failmsg("process wait failed", "status=%d", status);
+		zx_info_process_t info = {};
+		status = zx_object_get_info(process_, ZX_INFO_PROCESS, &info, sizeof(info), nullptr,
+					    nullptr);
+		zx_handle_close(process_);
+		process_ = ZX_HANDLE_INVALID;
+		if (status != ZX_OK)
+			failmsg("process info failed", "status=%d", status);
+		return static_cast<int>(info.return_code & 0xff);
+	}
+
+	Subprocess(const Subprocess&) = delete;
+	Subprocess& operator=(const Subprocess&) = delete;
+};
+
+#endif
diff --git a/zircon/kernel/lib/instrumentation/BUILD.gn b/zircon/kernel/lib/instrumentation/BUILD.gn
index 328ed13891a..86353265ebd 100644
--- a/zircon/kernel/lib/instrumentation/BUILD.gn
+++ b/zircon/kernel/lib/instrumentation/BUILD.gn
@@ -124,5 +124,15 @@ if (is_kernel) {
     if (configs + _asan_config - _asan_config != configs) {
       configs -= _asan_config
     }
+
+    # sancov code shouldn't be instrumented by sancov itself.  The coverage
+    # callbacks run from very early boot and before the sancov VMOs exist.
+    if (configs + _sancov_config - _sancov_config != configs) {
+      configs -= _sancov_config
+    }
+
+    # The callbacks can run before the compiler ABI state (e.g., x86
+    # safe-stack/stack-protector TLS) is initialized.
+    configs += [ "//build/config:no-compiler-abi" ]
   }
 }
