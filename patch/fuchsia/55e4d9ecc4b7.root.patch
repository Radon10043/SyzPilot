+}
+
+static zx_status_t SYZKALLER_FUCHSIA_COMPAT_UNUSED
+zx_ktrace_write(zx_handle_t resource, uint32_t id, uint32_t arg0, uint32_t arg1)
+{
+	return ZX_ERR_NOT_SUPPORTED;
+}
+
+static zx_status_t SYZKALLER_FUCHSIA_COMPAT_UNUSED
+zx_pager_query_dirty_ranges(zx_handle_t pager, zx_handle_t pager_vmo, uint64_t offset,
+			    uint64_t length, void* buffer, size_t buffer_size, uint64_t* actual,
+			    uint64_t* avail)
