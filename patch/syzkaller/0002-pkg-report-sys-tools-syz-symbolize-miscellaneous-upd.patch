@@ -40,6 +42,46 @@ func (*freebsd) prepareArch(arch *Arch) error {
 		filepath.Join(arch.buildDir, "x86")); err != nil {
 		return fmt.Errorf("failed to create link: %w", err)
 	}
+
+	// Generate necessary headers under sys/syzkaller for const extraction.
+	// device_if.h, bus_if.h, etc..
+	syzDir := filepath.Join(arch.sourceDir, "sys", "syzkaller")
+	awkArgs := []string{
+		"-f",
+		filepath.Join(arch.sourceDir, "sys", "tools", "makeobjops.awk"),
+		filepath.Join(arch.sourceDir, "sys", "kern", "device_if.m"),
+		filepath.Join(arch.sourceDir, "sys", "kern", "bus_if.m"),
+		"-h",
+	}
+	if err := osutil.MkdirAll(syzDir); err != nil {
+		return fmt.Errorf("failed to create directory: %w", err)
+	}
+	if _, err := osutil.RunCmd(10*time.Second, syzDir, "awk", awkArgs...); err != nil {
+		return fmt.Errorf("failed to run awk: %w", err)
+	}
+
+	// Generate vnode_if.h.
+	awkArgs = []string{
+		"-f",
+		filepath.Join(arch.sourceDir, "sys", "tools", "vnode_if.awk"),
+		filepath.Join(arch.sourceDir, "sys", "kern", "vnode_if.src"),
+		"-qhp",
+	}
+	if _, err := osutil.RunCmd(10*time.Second, syzDir, "awk", awkArgs...); err != nil {
+		return fmt.Errorf("failed to run awk: %w", err)
+	}
+
+	// Generate opt_*.h headers and save to sys/syzkaller.
+	confDir := filepath.Join(arch.sourceDir, "sys", "amd64", "conf")
+	configArgs := []string{
+		"-d",
+		syzDir,
+		"GENERIC",
+	}
+	if _, err := osutil.RunCmd(10*time.Second, confDir, "config", configArgs...); err != nil {
+		return fmt.Errorf("failed to run config command: %w", err)
+	}
+
 	return nil
 }
 
