diff --git a/executor/executor_fuchsia.h b/executor/executor_fuchsia.h
index bd2952c9e3..fa155037b9 100644
--- a/executor/executor_fuchsia.h
+++ b/executor/executor_fuchsia.h
@@ -2,15 +2,223 @@
 // Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
 
 #include <errno.h>
+#include <fcntl.h>
 #include <pthread.h>
 #include <stdlib.h>
 #include <string.h>
 #include <sys/mman.h>
+#include <sys/stat.h>
 #include <unistd.h>
 #include <zircon/status.h>
 #include <zircon/syscalls.h>
 
-#include "nocover.h"
+static const uint64 kFuchsiaSancovPcMagic = 0xc0bfffffffffff64ull;
+static const uint64 kFuchsiaSancovCountsMagic = 0x0023766f436e6153ull;
+
+// The Zircon kernel stores the call site rather than the return address: it
+// subtracts this bias from __builtin_return_address(0) so that the .sancov files
+// it publishes match what LLVM's sancov tool expects. See kReturnAddressBias in
+// zircon/kernel/lib/instrumentation/sancov.cc.
+//
+// syzkaller works the other way around: it is given return addresses and walks
+// back one instruction itself (PreviousInstructionPC). Add the bias back so the
+// PCs we report line up with the coverage callbacks found in the kernel ELF;
+// without this every PC misses its callback by one byte and coverage cannot be
+// symbolized at all.
+#if GOARCH_arm64
+static const uint64 kFuchsiaSancovReturnBias = 4;
+#else
+static const uint64 kFuchsiaSancovReturnBias = 1;
+#endif
+
+static uint64* fuchsia_sancov_pcs;
+static uint64* fuchsia_sancov_counts;
+static uint64 fuchsia_sancov_words;
+
+static size_t fuchsia_sancov_file_size(int fd)
+{
+	struct stat st;
+	if (fstat(fd, &st) == 0 && st.st_size > 0)
+		return st.st_size;
+	off_t size = lseek(fd, 0, SEEK_END);
+	lseek(fd, 0, SEEK_SET);
+	if (size > 0)
+		return size;
+	return 0;
+}
+
+static int fuchsia_sancov_open(const char* const* paths, size_t count, const char* kind)
+{
+	int last_errno = ENOENT;
+	for (size_t i = 0; i < count; i++) {
+		int fd = open(paths[i], O_RDONLY);
+		if (fd != -1) {
+			debug("using Fuchsia kernel sancov %s: %s\n", kind, paths[i]);
+			return fd;
+		}
+		last_errno = errno;
+	}
+	errno = last_errno;
+	failmsg("failed to open Fuchsia kernel sancov data", "%s: %s", kind, strerror(errno));
+}
+
+static uint64* fuchsia_sancov_map(const char* const* paths, size_t path_count, const char* kind, size_t* size)
+{
+	int fd = fuchsia_sancov_open(paths, path_count, kind);
+	*size = fuchsia_sancov_file_size(fd);
+	if (*size < 2 * sizeof(uint64) || (*size % sizeof(uint64)) != 0)
+		failmsg("bad Fuchsia kernel sancov size", "%s size=%zu", kind, *size);
+	void* data = mmap(NULL, *size, PROT_READ, MAP_SHARED, fd, 0);
+	int err = errno;
+	close(fd);
+	if (data == MAP_FAILED) {
+		errno = err;
+		failmsg("failed to mmap Fuchsia kernel sancov data", "%s: %s", kind, strerror(errno));
+	}
+	return (uint64*)data;
+}
+
+static void fuchsia_sancov_init()
+{
+	if (fuchsia_sancov_counts)
+		return;
+
+	static const char* const pc_paths[] = {
+	    "/boot/kernel/data/vmzircon.1.sancov",
+	    "/boot/kernel/i/sancov/d/data/vmzircon.1.sancov",
+	    "/boot/kernel/i/sancov/d/vmzircon.1.sancov",
+	    "/boot/kernel/i/sancov/d/i/sancov/d/data/vmzircon.1.sancov",
+	    "/boot/kernel/i/sancov/d/i/sancov/d/vmzircon.1.sancov",
+	    "/boot/kernel/i/sancov/dynamic/vmzircon.1.sancov",
+	    "/boot/kernel/i/sancov/dynamic/data/vmzircon.1.sancov",
+	    "/debugdata/sancov/dynamic/data/vmzircon.1.sancov",
+	    "/debugdata/sancov/dynamic/vmzircon.1.sancov",
+	};
+	static const char* const counts_paths[] = {
+	    "/boot/kernel/data/vmzircon.1.sancov-counts",
+	    "/boot/kernel/i/sancov-counts/d/data/vmzircon.1",
+	    "/boot/kernel/i/sancov-counts/d/data/vmzircon.1.sancov-counts",
+	    "/boot/kernel/i/sancov-counts/d/vmzircon.1",
+	    "/boot/kernel/i/sancov-counts/d/vmzircon.1.sancov-counts",
+	    "/boot/kernel/i/sancov-counts/d/i/sancov-counts/d/data/vmzircon.1",
+	    "/boot/kernel/i/sancov-counts/d/i/sancov-counts/d/data/vmzircon.1.sancov-counts",
+	    "/boot/kernel/i/sancov-counts/d/i/sancov-counts/d/vmzircon.1",
+	    "/boot/kernel/i/sancov-counts/d/i/sancov-counts/d/vmzircon.1.sancov-counts",
+	    "/boot/kernel/i/sancov-counts/dynamic/vmzircon.1",
+	    "/boot/kernel/i/sancov-counts/dynamic/vmzircon.1.sancov-counts",
+	    "/boot/kernel/i/sancov-counts/dynamic/data/vmzircon.1",
+	    "/boot/kernel/i/sancov-counts/dynamic/data/vmzircon.1.sancov-counts",
+	    "/debugdata/sancov-counts/dynamic/data/vmzircon.1",
+	    "/debugdata/sancov-counts/dynamic/data/vmzircon.1.sancov-counts",
+	    "/debugdata/sancov-counts/dynamic/vmzircon.1",
+	    "/debugdata/sancov-counts/dynamic/vmzircon.1.sancov-counts",
+	};
+
+	size_t pc_size = 0;
+	size_t counts_size = 0;
+	fuchsia_sancov_pcs = fuchsia_sancov_map(pc_paths, ARRAY_SIZE(pc_paths), "PCs", &pc_size);
+	fuchsia_sancov_counts = fuchsia_sancov_map(counts_paths, ARRAY_SIZE(counts_paths), "counts", &counts_size);
+	if (pc_size != counts_size)
+		failmsg("mismatching Fuchsia kernel sancov sizes", "pcs=%zu counts=%zu", pc_size, counts_size);
+	if (fuchsia_sancov_pcs[0] != kFuchsiaSancovPcMagic)
+		failmsg("bad Fuchsia kernel sancov PC magic", "magic=0x%llx", fuchsia_sancov_pcs[0]);
+	if (fuchsia_sancov_counts[0] != kFuchsiaSancovCountsMagic)
+		failmsg("bad Fuchsia kernel sancov counts magic", "magic=0x%llx", fuchsia_sancov_counts[0]);
+	fuchsia_sancov_words = counts_size / sizeof(uint64);
+	debug("Fuchsia kernel sancov mapped: %llu entries\n", fuchsia_sancov_words - 1);
+}
+
+static void cover_open(cover_t* cov, bool extra)
+{
+	fuchsia_sancov_init();
+	cov->data_size = kCoverSize * sizeof(uint64);
+}
+
+static void cover_enable(cover_t* cov, bool collect_comps, bool extra)
+{
+	cov->collect_comps = collect_comps;
+	cov->enabled = true;
+}
+
+static void cover_reset(cover_t* cov)
+{
+	if (!flag_coverage || cov == 0)
+		return;
+	// Threads mmap their coverage lazily: thread_create() only does it when the
+	// request that first needed the thread was collecting coverage. A later
+	// request that does collect coverage can reuse such a thread, and
+	// execute_call() then resets its cover_t while it is still unmapped. There is
+	// nothing to snapshot in that case, and nothing will be read back out of it
+	// either, so treat it as "not collecting" rather than failing the executor.
+	if (!cov->fuchsia_counts_snapshot)
+		return;
+	memcpy(cov->fuchsia_counts_snapshot, fuchsia_sancov_counts,
+	       fuchsia_sancov_words * sizeof(uint64));
+	*(uint64*)cov->data = 0;
+	cov->size = 0;
+	cov->overflow = false;
+}
+
+static void cover_collect(cover_t* cov)
+{
+	// See cover_reset(): an unmapped cover_t simply collected nothing.
+	if (!cov->fuchsia_counts_snapshot) {
+		cov->size = 0;
+		return;
+	}
+	uint64* out = (uint64*)cov->data;
+	uint64 max = cov->data_size / sizeof(uint64) - 1;
+	uint64 n = 0;
+
+	if (!cov->collect_comps) {
+		for (uint64 i = 1; i < fuchsia_sancov_words; i++) {
+			uint64 count = __atomic_load_n(&fuchsia_sancov_counts[i], __ATOMIC_RELAXED);
+			if (count == cov->fuchsia_counts_snapshot[i])
+				continue;
+			cov->fuchsia_counts_snapshot[i] = count;
+			uint64 pc = __atomic_load_n(&fuchsia_sancov_pcs[i], __ATOMIC_RELAXED);
+			if (pc == 0)
+				continue;
+			if (n == max) {
+				cov->overflow = true;
+				continue;
+			}
+			out[++n] = pc + kFuchsiaSancovReturnBias;
+		}
+	}
+	out[0] = n;
+	cov->size = n;
+}
