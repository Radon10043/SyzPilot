diff --git a/executor/conn.h b/executor/conn.h
index e1f3f7d0d2..75f9051e15 100644
--- a/executor/conn.h
+++ b/executor/conn.h
@@ -192,22 +192,44 @@ class Select
 public:
 	Select()
 	{
+#if !GOOS_fuchsia
 		FD_ZERO(&rdset_);
+#endif
 	}
 
 	void Arm(int fd)
 	{
+#if GOOS_fuchsia
+		pfds_.push_back({.fd = fd, .events = POLLIN, .revents = 0});
+#else
 		FD_SET(fd, &rdset_);
 		max_fd_ = std::max(max_fd_, fd);
+#endif
 	}
 
 	bool Ready(int fd) const
 	{
+#if GOOS_fuchsia
+		for (const auto& pfd : pfds_) {
+			if (pfd.fd == fd)
+				return pfd.revents & POLLIN;
+		}
+		return false;
+#else
 		return FD_ISSET(fd, &rdset_);
+#endif
 	}
 
 	void Wait(int ms)
 	{
+#if GOOS_fuchsia
+		for (;;) {
+			if (poll(pfds_.data(), pfds_.size(), ms) >= 0)
+				break;
+			if (errno != EINTR && errno != EAGAIN)
+				fail("poll failed");
+		}
+#else
 		timespec timeout = {.tv_sec = ms / 1000, .tv_nsec = (ms % 1000) * 1000 * 1000};
 		for (;;) {
 			if (pselect(max_fd_ + 1, &rdset_, nullptr, nullptr, &timeout, nullptr) >= 0)
@@ -216,6 +238,7 @@ public:
 			if (errno != EINTR && errno != EAGAIN)
 				fail("pselect failed");
 		}
+#endif
 	}
 
 	static void Prepare(int fd)
@@ -225,8 +248,12 @@ public:
 	}
 
 private:
+#if GOOS_fuchsia
+	std::vector<pollfd> pfds_;
+#else
 	fd_set rdset_;
 	int max_fd_ = -1;
+#endif
 
 	Select(const Select&) = delete;
 	Select& operator=(const Select&) = delete;
