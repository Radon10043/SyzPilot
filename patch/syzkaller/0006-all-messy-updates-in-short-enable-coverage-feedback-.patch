+	for _, summ := range apiSummary {
+		name := replacer.Replace(summ["name"].(string))
+		if value, ok := summ["value"].(string); ok {
+			vals[name], err = strconv.ParseUint(value, 10, 64)
+			if err != nil {
+				continue
+			}
+		}
+	}
+	for key := range undeclared {
+		if value, ok := vals[key]; ok {
+			res[key] = value
+			delete(undeclared, key)
+		}
+	}
+	return res, undeclared, nil
