+// extractFromJSONIR extracts consts from JSON IR files
+func (*fuchsia) extractFromJSONIR(
+	arch *Arch, res map[string]uint64, undeclared map[string]bool,
+) (map[string]uint64, map[string]bool, error) {
+	fidlDirs := []string{
+		filepath.Join(arch.sourceDir, "out", arch.target.KernelHeaderArch, "fidling", "gen", "sdk", "fidl"),
+		filepath.Join(arch.sourceDir, "out", arch.target.KernelHeaderArch, "fidling", "gen", "src", "storage", "fxfs"),
