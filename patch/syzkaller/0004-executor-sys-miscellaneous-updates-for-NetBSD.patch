 15 files changed, 68 insertions(+), 14 deletions(-)

diff --git a/executor/executor.cc b/executor/executor.cc
index d6bba7aa7d..c96bccf213 100644
--- a/executor/executor.cc
+++ b/executor/executor.cc
@@ -72,7 +72,11 @@ const int kOutPipeFd = kMaxFd - 2; // remapped from stdout
 const int kCoverFd = kOutPipeFd - kMaxThreads;
 const int kExtraCoverFd = kCoverFd - 1;
 const int kMaxArgs = 9;
+#ifdef GOOS_netbsd
+const int kCoverSize = 256 << 10;
+#else
 const int kCoverSize = 512 << 10;
+#endif
 const int kFailStatus = 67;
 
 // Two approaches of dealing with kcov memory.
diff --git a/executor/subprocess.h b/executor/subprocess.h
index d2b7327254..4988a82de5 100644
--- a/executor/subprocess.h
+++ b/executor/subprocess.h
@@ -13,9 +13,6 @@ class Subprocess
 public:
 	Subprocess(const char** argv, const std::vector<std::pair<int, int>>& fds)
 	{
-		posix_spawn_file_actions_t actions;
-		if (posix_spawn_file_actions_init(&actions))
-			fail("posix_spawn_file_actions_init failed");
 		int max_fd = 0;
 		for (auto pair : fds)
 			max_fd = std::max(max_fd, pair.second);
@@ -28,6 +25,40 @@ public:
 				if (pair.first <= max_fd)
 					failmsg("bad subprocess fd", "%d->%d max_fd=%d",
 						pair.first, pair.second, max_fd);
+			}
+		}
+
+#ifdef GOOS_netbsd
+		// On NetBSD, use fork+exec instead of posix_spawnp.
+		// NetBSD's posix_spawn can fail when the kernel is under fuzz testing,
+		// and closefrom() is a more robust way to close surplus file descriptors.
+		pid_ = fork();
+		if (pid_ == -1)
+			fail("fork failed");
+		if (pid_ == 0) {
+			// Create new process group so that we can kill all processes in the group.
+			setpgid(0, 0);
+			for (auto pair : fds) {
+				if (pair.first != -1) {
+					if (dup2(pair.first, pair.second) == -1)
+						_exit(127);
+				} else {
+					close(pair.second);
+				}
+			}
+			closefrom(max_fd + 1);
+			const char* child_envp[] = {
+			    "ASAN_OPTIONS=handle_segv=0 allow_user_segv_handler=1 detect_leaks=0",
+			    nullptr};
+			execve(argv[0], const_cast<char**>(argv), const_cast<char**>(child_envp));
+			_exit(127);
+		}
+#else
+		posix_spawn_file_actions_t actions;
+		if (posix_spawn_file_actions_init(&actions))
+			fail("posix_spawn_file_actions_init failed");
+		for (auto pair : fds) {
+			if (pair.first != -1) {
 				if (posix_spawn_file_actions_adddup2(&actions, pair.first, pair.second))
 					fail("posix_spawn_file_actions_adddup2 failed");
 			} else {
@@ -56,14 +87,16 @@ public:
 		    "GLIBC_TUNABLES=glibc.pthread.rseq=0",
 		    nullptr};
 
-		if (posix_spawnp(&pid_, argv[0], &actions, &attr,
-				 const_cast<char**>(argv), const_cast<char**>(child_envp)))
-			fail("posix_spawnp failed");
+		int err = posix_spawnp(&pid_, argv[0], &actions, &attr,
+				       const_cast<char**>(argv), const_cast<char**>(child_envp));
+		if (err)
+			failmsg("posix_spawnp failed", "err=%d (%s)", err, strerror(err));
 
 		if (posix_spawn_file_actions_destroy(&actions))
 			fail("posix_spawn_file_actions_destroy failed");
 		if (posix_spawnattr_destroy(&attr))
 			fail("posix_spawnattr_destroy failed");
+#endif
 	}
 
 	~Subprocess()
