+    "/debugdata/sancov-counts/dynamic/data/starnix_kernel",
+    "/debugdata/sancov-counts/dynamic/data/starnix_kernel.sancov-counts",
+    "/debugdata/sancov-counts/dynamic/starnix_kernel",
+    "/debugdata/sancov-counts/dynamic/starnix_kernel.sancov-counts",
+};
+
+static bool starnix_sancov_requested()
+{
+	return getenv("SYZ_STARNIX_SANCOV") != NULL ||
+	       getenv("SYZ_STARNIX_COVER_PCS") != NULL ||
+	       getenv("SYZ_STARNIX_COVER_COUNTS") != NULL;
+}
+
+static bool starnix_runtime_detected()
+{
+	char buf[256];
+	int fd = open("/proc/version", O_RDONLY);
+	if (fd == -1)
+		return false;
+	ssize_t n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0)
+		return false;
+	buf[n] = 0;
+	return strstr(buf, "starnix") != NULL || strstr(buf, "Starnix") != NULL;
+}
+
+static bool starnix_sancov_should_use()
+{
+	return starnix_sancov_requested() || starnix_runtime_detected();
+}
+
+static uint64* starnix_sancov_read_fd(int fd, const char* kind, size_t* size)
+{
+	size_t cap = 64 << 10;
+	size_t len = 0;
+	char* data = (char*)malloc(cap);
+	if (!data)
+		exitf("failed to allocate Starnix sancov read buffer");
+	if (lseek(fd, 0, SEEK_SET) < 0)
+		failmsg("failed to seek Starnix sancov data", "%s: %s", kind, strerror(errno));
+	for (;;) {
+		if (len == cap) {
+			cap *= 2;
+			char* new_data = (char*)realloc(data, cap);
+			if (!new_data)
+				exitf("failed to grow Starnix sancov read buffer");
+			data = new_data;
+		}
+		ssize_t n = read(fd, data + len, cap - len);
+		if (n < 0)
+			failmsg("failed to read Starnix sancov data", "%s: %s", kind, strerror(errno));
+		if (n == 0)
+			break;
+		len += n;
+	}
+	if (len < 2 * sizeof(uint64) || (len % sizeof(uint64)) != 0)
+		failmsg("bad Starnix sancov size", "%s size=%zu", kind, len);
+	*size = len;
+	return (uint64*)data;
+}
+
+static int starnix_sancov_try_open(const char* env_name, const char* const* paths, size_t count,
+				   const char* kind, const char** path_out)
+{
+	const char* env_path = getenv(env_name);
+	if (env_path && env_path[0] != 0) {
+		int fd = open(env_path, O_RDONLY);
+		if (fd != -1) {
+			debug("using Starnix sancov %s: %s\n", kind, env_path);
+			if (path_out)
+				*path_out = env_path;
+			return fd;
+		}
+		return -1;
+	}
+
+	for (size_t i = 0; i < count; i++) {
+		int fd = open(paths[i], O_RDONLY);
+		if (fd != -1) {
+			debug("using Starnix sancov %s: %s\n", kind, paths[i]);
+			if (path_out)
+				*path_out = paths[i];
+			return fd;
+		}
+	}
+	return -1;
+}
+
+static int starnix_sancov_open(const char* env_name, const char* const* paths, size_t count, const char* kind)
+{
+	const char* path = NULL;
+	int fd = starnix_sancov_try_open(env_name, paths, count, kind, &path);
+	if (fd != -1)
+		return fd;
+	const char* env_path = getenv(env_name);
+	if (env_path && env_path[0] != 0)
+		failmsg("failed to open Starnix sancov data", "%s=%s: %s", env_name, env_path, strerror(errno));
+	failmsg("failed to open Starnix sancov data", "%s: %s", kind, strerror(errno));
+}
+
+static uint64* starnix_sancov_read(const char* env_name, const char* const* paths, size_t path_count,
+				   const char* kind, size_t* size, int* fd_out)
+{
+	int fd = starnix_sancov_open(env_name, paths, path_count, kind);
+	uint64* data = starnix_sancov_read_fd(fd, kind, size);
+	if (fd_out)
+		*fd_out = fd;
+	else
+		close(fd);
+	return data;
+}
+
+static bool starnix_sancov_have_inherited_fds()
+{
+	return fcntl(kStarnixSancovPcFd, F_GETFD) != -1 &&
+	       fcntl(kStarnixSancovCountsFd, F_GETFD) != -1;
+}
+
+static int starnix_sancov_dup_for_runner(int fd, const char* kind)
+{
+	int dupfd = fcntl(fd, F_DUPFD_CLOEXEC, kStarnixSancovCountsFd + 1);
+	if (dupfd < 0)
+		dupfd = fcntl(fd, F_DUPFD, kStarnixSancovCountsFd + 1);
+	if (dupfd < 0)
+		failmsg("failed to dup Starnix sancov fd", "%s: %s", kind, strerror(errno));
+	close(fd);
+	return dupfd;
+}
+
+static void starnix_sancov_prepare_runner_fds()
+{
+	if (!starnix_sancov_should_use() || starnix_sancov_runner_pcs_fd != -1)
+		return;
+	for (int i = 0; i < 100; i++) {
+		int pcs_fd = starnix_sancov_try_open(
+		    "SYZ_STARNIX_COVER_PCS", starnix_sancov_pc_paths, ARRAY_SIZE(starnix_sancov_pc_paths), "PCs", NULL);
+		int counts_fd = starnix_sancov_try_open("SYZ_STARNIX_COVER_COUNTS", starnix_sancov_counts_paths,
+							ARRAY_SIZE(starnix_sancov_counts_paths), "counts", NULL);
+		if (pcs_fd != -1 && counts_fd != -1) {
+			starnix_sancov_runner_pcs_fd = starnix_sancov_dup_for_runner(pcs_fd, "PCs");
+			starnix_sancov_runner_counts_fd = starnix_sancov_dup_for_runner(counts_fd, "counts");
+			return;
+		}
+		if (pcs_fd != -1)
+			close(pcs_fd);
+		if (counts_fd != -1)
+			close(counts_fd);
+		usleep(100 * 1000);
+	}
+	int pcs_fd = starnix_sancov_open("SYZ_STARNIX_COVER_PCS", starnix_sancov_pc_paths,
+					 ARRAY_SIZE(starnix_sancov_pc_paths), "PCs");
+	close(pcs_fd);
+	int counts_fd = starnix_sancov_open("SYZ_STARNIX_COVER_COUNTS", starnix_sancov_counts_paths,
+					    ARRAY_SIZE(starnix_sancov_counts_paths), "counts");
+	close(counts_fd);
+}
+
+static int starnix_sancov_child_fd_max()
+{
+	if (starnix_sancov_runner_pcs_fd == -1)
+		return kCoverFilterFd;
+	return kStarnixSancovCountsFd;
+}
+
+static void starnix_sancov_refresh_counts()
+{
+	size_t counts_size = 0;
+	uint64* counts = starnix_sancov_read_fd(starnix_sancov_counts_fd, "counts", &counts_size);
+	if (counts_size != starnix_sancov_counts_size)
+		failmsg("changed Starnix sancov counts size", "was=%zu now=%zu",
+			starnix_sancov_counts_size, counts_size);
+	if (counts[0] != kStarnixSancovCountsMagic)
+		failmsg("bad Starnix sancov counts magic", "magic=0x%llx", counts[0]);
+	free(starnix_sancov_counts);
+	starnix_sancov_counts = counts;
+}
+
+static void starnix_sancov_init()
+{
+	if (starnix_sancov_counts)
+		return;
+
+	size_t pc_size = 0;
+	size_t counts_size = 0;
+	if (starnix_sancov_have_inherited_fds()) {
+		debug("using inherited Starnix sancov fds\n");
+		starnix_sancov_pcs = starnix_sancov_read_fd(kStarnixSancovPcFd, "PCs", &pc_size);
+		starnix_sancov_counts_fd = kStarnixSancovCountsFd;
+		starnix_sancov_counts = starnix_sancov_read_fd(starnix_sancov_counts_fd, "counts", &counts_size);
+	} else {
+		starnix_sancov_pcs = starnix_sancov_read("SYZ_STARNIX_COVER_PCS", starnix_sancov_pc_paths,
+							 ARRAY_SIZE(starnix_sancov_pc_paths), "PCs", &pc_size, NULL);
+		starnix_sancov_counts = starnix_sancov_read(
+		    "SYZ_STARNIX_COVER_COUNTS", starnix_sancov_counts_paths,
+		    ARRAY_SIZE(starnix_sancov_counts_paths), "counts", &counts_size, &starnix_sancov_counts_fd);
+	}
+	if (pc_size != counts_size)
+		failmsg("mismatching Starnix sancov sizes", "pcs=%zu counts=%zu", pc_size, counts_size);
+	if (starnix_sancov_pcs[0] != kStarnixSancovPcMagic)
+		failmsg("bad Starnix sancov PC magic", "magic=0x%llx", starnix_sancov_pcs[0]);
+	if (starnix_sancov_counts[0] != kStarnixSancovCountsMagic)
+		failmsg("bad Starnix sancov counts magic", "magic=0x%llx", starnix_sancov_counts[0]);
+	starnix_sancov_words = counts_size / sizeof(uint64);
+	starnix_sancov_counts_size = counts_size;
+	starnix_sancov_enabled = true;
+	debug("Starnix sancov loaded: %llu entries\n", starnix_sancov_words - 1);
+}
